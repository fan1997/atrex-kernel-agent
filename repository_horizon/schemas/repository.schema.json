{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "name", "source", "editable_roots", "adapter"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "adapter": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["name", "revision", "archive_paths"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "archive_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "package_root": {"type": "string", "default": "."}
      },
      "additionalProperties": false
    },
    "editable_roots": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "runtime_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["distribution", "import", "version"],
        "properties": {
          "distribution": {"type": "string"},
          "import": {"type": "string"},
          "version": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "measurement": {"type": "object"}
  },
  "additionalProperties": false
}
