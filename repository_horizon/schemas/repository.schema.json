{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "name", "source", "editable_roots", "adapter"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "adapter": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["name", "revision", "archive_paths"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "archive_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "package_root": {"type": "string", "default": "."}
      },
      "additionalProperties": false
    },
    "editable_roots": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "runtime_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["distribution", "import", "version"],
        "properties": {
          "distribution": {"type": "string"},
          "import": {"type": "string"},
          "version": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "runtime_support": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["distribution", "version", "package", "members"],
        "properties": {
          "distribution": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "package": {"type": "string", "minLength": 1},
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "dist_info_members": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "generate_minimal_init": {"type": "boolean", "default": true}
        },
        "additionalProperties": false
      }
    },
    "repository_search": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["snapshot", "replay_strict", "allowlist"],
          "default": "snapshot"
        },
        "refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "excluded_commits": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        },
        "require_report": {"type": "boolean"},
        "seal_before_first_eval": {"type": "boolean", "default": false},
        "min_candidates": {"type": "integer", "minimum": 1, "default": 1}
      },
      "additionalProperties": false
    },
    "bringup": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["disabled", "auto"], "default": "disabled"},
        "probe_repeats": {"type": "integer", "minimum": 1, "default": 1}
      },
      "additionalProperties": false
    },
    "measurement": {"type": "object"}
  },
  "additionalProperties": false
}
